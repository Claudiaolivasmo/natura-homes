# Public site URL, used for canonical URLs, sitemap, hreflang and Open Graph
NEXT_PUBLIC_SITE_URL=https://www.naturahomes.cr

# WhatsApp number in international format, digits only (e.g. 50688887777)
NEXT_PUBLIC_WHATSAPP_NUMBER=

# Public contact details shown on the site (leave empty to hide)
NEXT_PUBLIC_CONTACT_EMAIL=
NEXT_PUBLIC_INSTAGRAM_URL=
NEXT_PUBLIC_FACEBOOK_URL=

# ---- Formspree IDs (replace each placeholder with its Formspree form ID) ----
NEXT_PUBLIC_FORMSPREE_CONTACT_ID=YOUR_CONTACT_FORM_ID
NEXT_PUBLIC_FORMSPREE_CONSULTATION_ID=YOUR_CONSULTATION_FORM_ID
NEXT_PUBLIC_FORMSPREE_CONCIERGE_ID=YOUR_CONCIERGE_FORM_ID
NEXT_PUBLIC_FORMSPREE_PROPERTY_INQUIRY_ID=YOUR_PROPERTY_INQUIRY_FORM_ID

# ---- Legacy /api/inquiry delivery (not used by the website forms) ----
FORM_WEBHOOK_URL=
FORM_WEBHOOK_SECRET=
RESEND_API_KEY=
FORM_EMAIL_TO=
FORM_EMAIL_FROM="Natura Homes <web@naturahomes.cr>"
